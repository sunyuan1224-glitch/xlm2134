{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyNovel",
  "version": "0.1.1",
  "identifier": "com.local.mynovel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyNovel",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "MyNovel 二次元小说写作软件",
    "longDescription": "MyNovel 是一款本地优先、适合创作长篇小说的轻量写作工具。"
  }
}
