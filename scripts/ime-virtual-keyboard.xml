<?xml version="1.0" encoding="UTF-8"?>
<!--
  zwp_virtual_keyboard_unstable_v1（与 wlroots / wlr-protocols 上游定义一致）。
  只用于 IME 验收：把「像真人敲键盘」的按键事件交给合成器，
  再走 GTK → 合成器 text-input-v3 → fcitx5(input-method-v2) → rime 的真实输入法链路。
-->
<protocol name="virtual_keyboard_unstable_v1">
  <interface name="zwp_virtual_keyboard_v1" version="1">
    <request name="keymap">
      <arg name="format" type="uint" summary="keymap format"/>
      <arg name="fd" type="fd" summary="keymap file descriptor"/>
      <arg name="size" type="uint" summary="keymap size"/>
    </request>
    <request name="key">
      <arg name="time" type="uint" summary="timestamp with millisecond granularity"/>
      <arg name="key" type="uint" summary="keymap-unmapped keycode"/>
      <arg name="state" type="uint" summary="key state"/>
    </request>
    <request name="modifiers">
      <arg name="mods_depressed" type="uint" summary="depressed modifiers"/>
      <arg name="mods_latched" type="uint" summary="latched modifiers"/>
      <arg name="mods_locked" type="uint" summary="locked modifiers"/>
      <arg name="group" type="uint" summary="keyboard layout"/>
    </request>
    <request name="destroy" type="destructor"/>
  </interface>
  <interface name="zwp_virtual_keyboard_manager_v1" version="1">
    <request name="create_virtual_keyboard">
      <arg name="seat" type="object" interface="wl_seat"/>
      <arg name="id" type="new_id" interface="zwp_virtual_keyboard_v1"/>
    </request>
  </interface>
</protocol>
